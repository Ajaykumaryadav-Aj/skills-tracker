# Global Environment Configuration

# Backend API Configuration
API_PORT=5000
NODE_ENV=production
MONGO_URI=mongodb://127.0.0.1:27017/skills_tracker
JWT_SECRET=replace_with_a_secure_32_character_long_string
JWT_EXPIRES_IN=7d

# Auth & Admin Configuration
ADMIN_EMAILS=admin@example.com,developer@example.com
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:5174

# Email SMTP Credentials (for OTP Registration / Password Resets)
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password

# Rate Limits
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# AI Services Configurations (OpenAI, Gemini, Claude)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key

# Cloudinary Storage Configurations (File Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# Frontend User Portal Configuration
WEB_PORT=8080
VITE_API_BASE=/api

# Frontend Admin Portal Configuration
ADMIN_PORT=8081
