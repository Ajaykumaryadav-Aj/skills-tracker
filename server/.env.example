NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skills_tracker
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password
CLIENT_URL=http://localhost:5173
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
TRUST_PROXY=false
MONGO_MAX_POOL_SIZE=20
JSON_BODY_LIMIT=100kb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
API_CACHE_ENABLED=true
API_CACHE_TTL_SECONDS=30
API_CACHE_MAX_ENTRIES=500
LOG_LEVEL=debug
