# =============================================================
# Skills Tracker – Server Environment Variables (Production)
# =============================================================
# Set these as environment variables in your Render dashboard.
# NEVER commit actual secrets to source control.

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
TRUST_PROXY=true

# ── Database ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/skills_tracker
MONGO_MAX_POOL_SIZE=30

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_random_hex_characters
JWT_EXPIRES_IN=7d

# ── Admin Access ──────────────────────────────────────────────
ADMIN_EMAILS=your_admin@example.com

# ── Email / SMTP ──────────────────────────────────────────────
# Use a Gmail App Password (not your Gmail login password)
# Gmail App Passwords: https://myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16char_gmail_app_password

# ── CORS ──────────────────────────────────────────────────────
# Add your exact Vercel frontend URL (no trailing slash)
CORS_ORIGINS=https://your-app.vercel.app,https://your-admin.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Cloudinary (Required in production) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Services ───────────────────────────────────────────────
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
