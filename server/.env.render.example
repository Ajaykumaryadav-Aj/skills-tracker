NODE_ENV=production
MONGO_URI=mongodb+srv://app_user:replace_password@cluster.example.mongodb.net/skills_tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1d
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=https://skills-tracker.vercel.app,https://skills-tracker-admin.vercel.app
TRUST_PROXY=true
MONGO_MAX_POOL_SIZE=20
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
API_CACHE_ENABLED=true
API_CACHE_TTL_SECONDS=30
LOG_LEVEL=info
