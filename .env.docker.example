MONGO_URI=mongodb+srv://app_user:replace_password@cluster.example.mongodb.net/skills_tracker?retryWrites=true&w=majority
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1d
ADMIN_EMAILS=admin@example.com
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
API_PORT=5000
WEB_PORT=8080
ADMIN_PORT=8081
MONGO_MAX_POOL_SIZE=20
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
API_CACHE_ENABLED=true
API_CACHE_TTL_SECONDS=30
API_CACHE_MAX_ENTRIES=500
LOG_LEVEL=info
